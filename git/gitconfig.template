[user]
    name = {AUTHOR_NAME}
    email = {AUTHOR_EMAIL}
    signingkey = {GIT_SIGNING_KEY}

[alias]
    co = checkout
    sw = switch # replace `checkout -b` with `switch` for switching branches
    re = restore # use `checkout <ref> -- ` with `restore` for restoring files
    ci = commit
    st = status
    br = branch
    bn = rev-parse --abbrev-ref HEAD
    one = log --pretty=format:'%C(blue)%h %C(green)%<(12)%ad %C(auto,yellow)%<(12,trunc)%an %C(auto,magenta)%G?%C(auto)%d %s' --date=relative
    graph = one --graph
    type = cat-file -t
    dump = cat-file -p
    patch = !git --no-pager diff --no-color
    snapshot = !git stash save "snapshot: $(date)" && git stash apply "stash@{0}"
    fa = fuzzy-add
    fb = fuzzy-branch
    ff = fuzzy-files
    fco = fuzzy-checkout
    fsw = fuzzy-switch
    fre = fuzzy-restore
    dt = difftool
    mt = mergetool
    wt = worktree
    wtls = wt list
    wtadd = wt add
    wtmv = wt move
    wtrm = wt remove
    wtprune = wt prune
    h = history

    stashgrep = "!f() { for i in `git stash list --format=\"%gd\"` ; do git stash show -p $i | grep -H --label=\"$i\" \"$@\" ; done ; }; f"

[merge]
    tool = vim_mergetool
    conflictStyle = diff3
[mergetool]
    keepBackup = false
[mergetool "vim_mergetool"]
    cmd = nvim -f -c "MergetoolStart" "$MERGED" "$BASE" "$LOCAL" "$REMOTE"
    trustExitCode = true
[core]
    excludesfile = ~/.gitignore-global
    ignorecase = true
[push]
    default = {GIT_PUSH_DEFAULT}
[color]
    ui = auto
[color "diff"]
    meta = blue bold
    commit = yellow
    frag = magenta bold
    old = red bold
    new = green
    whitespace = red reverse
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green
    newHighlight = green 22
[color "branch"]
    current = reverse
    local = yellow bold
    remote = green bold
[color "status"]
    header = green bold
    added = green
    changed = red
    untracked = magenta bold
    branch = cyan
    nobranch = magenta
    unmerged = red bold
[branch]
    autosetuprebase = always
    autosetupmerge = always
[credential]
    helper = {GIT_CREDENTIAL_HELPER}
[web]
    browser = open
[rerere]
    enabled = 1
[fetch]
    prune = true
[help]
    autocorrect = prompt
[commit]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
[diff]
    algorithm = histogram
    indentHeuristic = true
    tool = vimdiff
[difftool]
    prompt = false
[pager]
    diff = command -v delta >/dev/null 2>&1 && delta || less -RsXFi -x4 -j2
    log = command -v delta >/dev/null 2>&1 && delta || less -RsXFi -x4 -j2 -p"^commit.*$"
    reflog = command -v delta >/dev/null 2>&1 && delta || less -RsXFi -x4 -j2
    show = command -v delta >/dev/null 2>&1 && delta || less -RsXFi -x4 -j2
[interactive]
    diffFilter = delta --color-only
[delta]
    syntax-theme = Nord
    line-numbers = true
[blame]
    markIgnoredLines = true
    markUnblamedLines = true
[init]
    defaultBranch = main

