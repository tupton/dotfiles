{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "nord"
  },
  "keybinds": {
    "input.newline": "shift+return,ctrl+return,alt+return"
  },
  "plugins": [
    "./herdr-opencode",
    "opencode-github-pr-status@0.4.0"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
