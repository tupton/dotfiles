{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "next-devtools": {
        "disabled": true,
        "type": "local",
        "command": ["npx", "-y", "next-devtools-mcp"]
      },
      "linear": {
        "disabled": false,
        "type": "local",
        "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"]
      },
      "mantine": {
        "disabled": true,
        "type": "local",
        "command": ["npx", "-y", "@mantine/mcp-server"]
      },
      "datadog": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp"
      },
      "figma": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "oauth": {
          "client_id": "{env:FIGMA_CLIENT_ID}",
          "client_secret": "{env:FIGMA_CLIENT_SECRET}"
        }
      },
      "statsig": {
        "disabled": true,
        "type": "remote",
        "url": "https://api.statsig.com/v1/mcp"
      },
      "metabase": {
        "disabled": true,
        "type": "remote",
        "url": "https://wizehire.metabaseapp.com/api/metabase-mcp"
      },
      "granola": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.granola.ai/mcp"
      },
      "playwright": {
        "disabled": true,
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      }
    }
  }
}
