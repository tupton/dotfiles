{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "input_newline": "shift+return,ctrl+return,alt+return"
  },
  "plugin": [
    "./herdr-tui-session.js",
    [
      "@leohenon/opencode-vim-plugin",
      {
        "enabled": true,
        "indicator": true,
        "vim_enter_submit": false,
        "vim_insert_after_submit": true,
        "vim_system_clipboard_register": true
      }
    ]
  ]
}
{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "input_newline": "shift+return,ctrl+return,alt+return"
  },
  "plugin": [
    "./herdr-tui-session.js",
    [
      "@leohenon/opencode-vim-plugin",
      {
        "enabled": true,
        "indicator": true,
        "vim_initial_mode": "insert",
        "vim_enter_submit": true,
        "vim_insert_after_submit": true,
        "vim_system_clipboard_register": true
      }
    ]
  ]
}
